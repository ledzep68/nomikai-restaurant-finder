# Development Environment Variables
NODE_ENV=development
PORT=3000

# Database Configuration (必須設定)
DB_TYPE=sqlite
DB_PATH=./database/nomikai.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nomikai_restaurant_finder
DB_USER=postgres
DB_PASSWORD=

# Database Backup Configuration
DATABASE_BACKUP_PATH=./database/backups/

# Database Migration Configuration
MIGRATION_PATH=./src/database/migrations/
MIGRATION_TABLE_NAME=migrations

# Redis (optional for development)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev_jwt_secret_key_nomikai_2025
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:8090,http://localhost:8091

# External APIs - Development Mode
# Set USE_MOCK_API=false to use real APIs
USE_MOCK_API=false

# HotPepper API (リクルートWebサービス)
HOTPEPPER_API_ENDPOINT=https://webservice.recruit.co.jp/hotpepper
HOTPEPPER_API_KEY=cdfc8dd77824a1cd
HOTPEPPER_RATE_LIMIT=100
HOTPEPPER_TIMEOUT=10000
HOTPEPPER_CACHE_TTL=86400

# Google Places API
GOOGLE_PLACES_API_ENDPOINT=https://maps.googleapis.com/maps/api/place
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACES_RATE_LIMIT=100
GOOGLE_PLACES_TIMEOUT=10000
GOOGLE_PLACES_CACHE_TTL=2592000

# Tabelog Scraping (Personal Use Only)
TABELOG_BASE_URL=https://tabelog.com
TABELOG_REQUEST_DELAY=30000
TABELOG_CACHE_TTL=43200
TABELOG_PERSONAL_USE_ONLY=true
TABELOG_RESPECTFUL_ACCESS=true

# HotPepper-Centric Configuration (Google Places無効)
PLATFORM_WEIGHTS_HOTPEPPER=0.85
PLATFORM_WEIGHTS_TABELOG=0.15
PLATFORM_WEIGHTS_GOOGLE=0.00

# Cache Settings
CACHE_TTL_SEARCH=3600      # 1 hour for search results
CACHE_TTL_DETAIL=86400     # 24 hours for restaurant details
CACHE_TTL_STATIC=2592000   # 30 days for static content

# Feature Flags - HotPepper-Centric Implementation
ENABLE_HOTPEPPER=true
ENABLE_GOOGLE_PLACES=false
ENABLE_TABELOG=true
ENABLE_FREE_TIER_MODE=true
ENABLE_HOTPEPPER_PRIMARY=true
ENABLE_CACHE=true
ENABLE_RATE_LIMIT=true

# Free Tier Rate Limiting
HOTPEPPER_FREE_TIER_RPM=2
HOTPEPPER_FREE_TIER_RPH=50
HOTPEPPER_FREE_TIER_RPD=300
TABELOG_FREE_TIER_WEEKLY_LIMIT=50

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev