# Frontend Development Environment Variables

# React App Environment
REACT_APP_NODE_ENV=development

# API Configuration
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_USE_MOCK_API=true

# Feature Flags
REACT_APP_ENABLE_MOCK_DATA=true
REACT_APP_SHOW_DEBUG_INFO=true

# External Services (for real API usage)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Performance
REACT_APP_ENABLE_SERVICE_WORKER=false
REACT_APP_BUNDLE_ANALYZER=false

# Development Tools
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_LOG_LEVEL=debug